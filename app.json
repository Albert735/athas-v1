{
  "expo": {
    "name": "Raute",
    "slug": "raute",
    "scheme": "raute",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/raute-app-icon-1024.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.anonymous.rautev1",
    "infoPlist": {
      "NSLocationWhenInUseUsageDescription": "Raute uses your location to show you on the map and calculate walking routes to campus buildings."
    }
  },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/athas-adaptive-foreground-1024.png",
        "backgroundImage": "./assets/images/raute-splash-icon-1024.png",
        "monochromeImage": "./assets/images/raute-app-icon-1024.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "package": "com.anonymous.rautev1"
    },
    "web": {
      "output": "static",
      "favicon": "assets/images/icon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
         "image": "./assets/images/raute-splash-icon-1024.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@rnmapbox/maps"
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}